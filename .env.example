# Copy to .env and fill in. .env is gitignored and must never be committed.

DJANGO_SECRET_KEY=generate-a-new-one-see-readme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production when using HTTPS (comma-separated full origins).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://freight-audit.example.com

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courier_recon

# Optional Gunicorn tuning (Docker / production).
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=120

# Public read-only demo: drops the login requirement and disables all write
# endpoints. Leave unset for a normal authenticated deployment.
# DEMO_READONLY=False
